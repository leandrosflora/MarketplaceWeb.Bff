{
  "Services": {
    "ProductCatalog": "http://product-catalog-service",
    "ProductSearch": "http://product-search-service",
    "ShippingPromise": "http://shipping-promise-service",
    "Checkout": "http://checkout-service",
    "Order": "http://order-service",
    "Shipment": "http://shipment-service",
    "Tracking": "http://tracking-service"
  },
  "ConnectionStrings": {
    "Redis": "redis:6379"
  },
  "Kafka": {
    "BootstrapServers": "kafka:9092",
    "CartAbandonedTopic": "cart.abandoned"
  },
  "Cart": {
    "AbandonmentThresholdMinutes": 60,
    "ScanIntervalSeconds": 300
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
