@MarketplaceWeb_Bff_HostAddress = https://localhost:7171
@skuId = 00000000-0000-0000-0000-000000000001
@buyerId = 11111111-1111-1111-1111-111111111111
@sellerId = 22222222-2222-2222-2222-222222222222
@checkoutId = 00000000-0000-0000-0000-000000000004
@orderId = 00000000-0000-0000-0000-000000000002
@shipmentId = 00000000-0000-0000-0000-000000000003

GET {{MarketplaceWeb_Bff_HostAddress}}/api/web/v1/products/search?query=smartphone&page=1&pageSize=20
Accept: application/json

###

GET {{MarketplaceWeb_Bff_HostAddress}}/api/web/v1/products/{{skuId}}/page?zipCode=05726100&quantity=1
Accept: application/json

###

POST {{MarketplaceWeb_Bff_HostAddress}}/api/web/v1/checkouts/
Accept: application/json
Content-Type: application/json
Idempotency-Key: checkout-create-001

{
  "buyerId": "{{buyerId}}",
  "sellerId": "{{sellerId}}",
  "shippingAddress": {
    "zipCode": "05726100",
    "city": "São Paulo",
    "state": "SP",
    "country": "BR"
  },
  "items": [
    {
      "skuId": "{{skuId}}",
      "quantity": 1,
      "unitPrice": 99.90
    }
  ]
}

###

GET {{MarketplaceWeb_Bff_HostAddress}}/api/web/v1/checkouts/{{checkoutId}}
Accept: application/json

###

POST {{MarketplaceWeb_Bff_HostAddress}}/api/web/v1/checkouts/{{checkoutId}}/confirm
Accept: application/json
Content-Type: application/json
Idempotency-Key: checkout-confirm-001

{
  "paymentIntentId": "pi_123456789"
}

###

GET {{MarketplaceWeb_Bff_HostAddress}}/api/web/v1/orders/{{orderId}}
Accept: application/json

###

GET {{MarketplaceWeb_Bff_HostAddress}}/api/web/v1/orders/{{orderId}}/tracking
Accept: application/json

###

GET {{MarketplaceWeb_Bff_HostAddress}}/api/web/v1/shipments/{{shipmentId}}/label
Accept: application/pdf
